via_lipidios_aterosclerose/dados/processed/*.csv
via_lipidios_aterosclerose/liver*.csv
via_lipidios_aterosclerose/liver*.xlsx
via_lipidios_aterosclerose/liver_lip_ateroscler*.tsv

